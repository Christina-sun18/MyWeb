require(tidyverse)
a<- c("the", "quick", "brown", "hen","ate","corn")
b<- c("the", "little", "red", "hen","ate","corn")
d<- c("the", "cat", "in", "the", "red", "hat")
e<- c("the", "fast", "little","rabbit") >
jaccard <- function(a, b) {
a<-unique(a)
b<-unique(b)
intersection = length(intersect(a, b))
union = length(a) + length(b) - intersection
return (intersection/union)
}
a<- c("the", "quick", "brown", "hen","ate","corn")
b<- c("the", "little", "red", "hen","ate","corn")
d<- c("the", "cat", "in", "the", "red", "hat")
e<- c("the", "fast", "little","rabbit")
jaccard <- function(a, b){
a<-unique(a)
b<-unique(b)
intersection = length(intersect(a, b))
union = length(a) + length(b) - intersection
return (intersection/union)
}
distA<-c(jaccard(a,a),jaccard(a,b),jaccard(a,d),jaccard(a,e))
distB<-c(jaccard(b,a),jaccard(b,b),jaccard(b,d),jaccard(b,e))
distC<-c(jaccard(d,a),jaccard(d,b),jaccard(d,d),jaccard(d,e))
distD<-c(jaccard(e,a),jaccard(e,b),jaccard(e,d),jaccard(e,e))
distmat<-1-rbind(distA,distB,distC,distD)
distmat
m<-as.dist(distmat)
plot(hclust(m,method="complete"), cex=0.8)
plot(hclust(m,method="average"), cex=0.8)
plot(hclust(m,method="complete"), cex=0.8)
cutree(hclust(m, method = "complete"), k = 3)
